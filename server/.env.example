########################################
# Database
########################################

# MongoDB connection URI
# Example:
# mongodb://localhost:27017/pcss
MONGODB_URI=

########################################
# Server
########################################

# Server bind IP
# Example: 127.0.0.1
SERVER_IP=127.0.0.1

# Server port
# Example: 8089
SERVER_PORT=8089

# Public base URL of this server
# Example: http://127.0.0.1:8089
URL_BASE=

########################################
# Custom LLM / API
########################################

# Base URL of custom API (LLM backend)
# Example: http://localhost:8001
CUSTOM_API_URL=

# Authentication token for custom API
CUSTOM_TOKEN=

# Model path or model name used by the custom API
# Example: /models/name-classifier
CUSTOM_MODEL=

########################################
# LLM Settings
########################################

# LLM name source
# Example values:
# - openai
# - custom
# - local
LLM_NAME_SOURCE=

# Enable/disable name score cache
# true | false
NAME_CACHE=true

########################################
# Crawler Settings
########################################

# Force crawl from web even if local cache exists
# true | false
FORCE_CRAWL=false
